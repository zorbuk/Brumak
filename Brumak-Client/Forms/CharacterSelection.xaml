<Window x:Class="Brumak_Client.Forms.CharacterSelection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:Brumak_Client.Forms.Controls"
        Title="Brumak - Selección de personaje"
        Height="600" Width="1000"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#111"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Forms/Style/MainStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CharacterRow" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="CharacterRowSelected" TargetType="Border">
                <Setter Property="Background" Value="#22FFFFFF"/>
                <Setter Property="BorderBrush" Value="#FFAA44"/>
                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                <Setter Property="Padding" Value="9,10"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="PlayButton" TargetType="Button">
                <Setter Property="Background" Value="#FFAA44"/>
                <Setter Property="Foreground" Value="#111"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#FFBB66"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#FF9922"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                    <Setter Property="Foreground" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="#22FFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="14,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#44FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#11FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="Background" Value="#33FF3344"/>
                <Setter Property="Foreground" Value="#FF3344"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="BorderBrush" Value="#44FF3344"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="14,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#55FF3344"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ClassBadge" TargetType="Border">
                <Setter Property="Background" Value="#33FFFFFF"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>

        <Image x:Name="ServerSplashArt"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Opacity="0.5"/>

        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.1"/>
                    <GradientStop Color="#CC000000" Offset="0.6"/>
                    <GradientStop Color="#EE000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle HorizontalAlignment="Left" Width="420">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#EE000000" Offset="0"/>
                    <GradientStop Color="#AA000000" Offset="0.6"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Border Width="360"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="#AA000000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,74,20,12">
                    <TextBlock FontSize="10"
                               FontWeight="Bold"
                               Foreground="#88FFFFFF"
                               FontFamily="Segoe UI">
                        MIS PERSONAJES EN
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   FontFamily="Segoe UI">
                            SERVIDOR:
                        </TextBlock>
                        <TextBlock x:Name="ServerNameLabel"
                                   Text="AETHER"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FFAA44"
                                   FontFamily="Segoe UI"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="20,0,20,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1"
                               Text="NOMBRE"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#55FFFFFF"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="CLASE"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#55FFFFFF"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3"
                               Text="NIV."
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#55FFFFFF"
                               FontFamily="Segoe UI"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <Rectangle Grid.Row="1"
                           Height="1"
                           Fill="#22FFFFFF"
                           VerticalAlignment="Bottom"
                           Margin="20,0,20,0"/>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Hidden"
                              Margin="0,4,0,0">
                    <StackPanel x:Name="CharacterListPanel"/>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="20,12,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="DeleteCharacterBtn"
                            Content="ELIMINAR"
                            Style="{StaticResource DangerButton}"
                            IsEnabled="False"
                            Click="DeleteCharacter_Click"/>

                    <Button Grid.Column="2"
                            x:Name="CreateCharacterBtn"
                            Content="CREAR PERSONAJE"
                            Style="{StaticResource SecondaryButton}"
                            Click="CreateCharacter_Click"/>
                </Grid>

            </Grid>
        </Border>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="360,0,40,40"
                    Width="540">

            <Border x:Name="CharacterPreviewHost"
                    Width="180" Height="240"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,20,0,60"
                    Background="Transparent"/>

            <TextBlock x:Name="SelectedCharacterName"
                       Text="JohnDoe"
                       FontSize="42"
                       FontWeight="Bold"
                       FontFamily="Segoe UI"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2"/>
                </TextBlock.Effect>
            </TextBlock>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                <Border Style="{StaticResource ClassBadge}" Margin="0,0,8,0">
                    <TextBlock x:Name="SelectedCharacterClass"
                               Text="Encantador"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               FontFamily="Segoe UI"/>
                </Border>
                <Border Background="#33FFAA44"
                        BorderBrush="#44FFAA44"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="6,2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="NIV. "
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#FFAA44"
                                   FontFamily="Segoe UI"/>
                        <TextBlock x:Name="SelectedCharacterLevel"
                                   Text="1"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#FFAA44"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button x:Name="PlayBtn"
                    Content="JUGAR"
                    Style="{StaticResource PlayButton}"
                    Width="200"
                    HorizontalAlignment="Center"
                    IsEnabled="False"
                    Click="Play_Click"/>
        </StackPanel>

        <Grid VerticalAlignment="Top" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="‹"
                    Style="{StaticResource WindowButton}"
                    Click="Back_Click"/>

            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="NicknameLabel"
                           Text="{Binding Nickname}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="White"
                           FontFamily="Segoe UI"/>
                <TextBlock x:Name="PremiumLabel"
                           Text="{Binding PremiumStatus}"
                           FontSize="10"
                           Foreground="#FFAA44"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="85,0,0,0">
                <Rectangle Width="50" Height="1" Fill="#88FFAA44" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Selecciona un personaje"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <Rectangle Width="50" Height="1" Fill="#88FFAA44" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click"/>
                <Button Content="X" Style="{StaticResource WindowButton}" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Button HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,14,14"
                Width="36" Height="36"
                FontSize="14"
                Panel.ZIndex="2"
                Cursor="Hand"
                Click="AudioBtn_Click"
                ToolTip="Ajustes de audio">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#161616"/>
                    <Setter Property="BorderBrush" Value="#2C2C2C"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Foreground" Value="#888888"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#D13639"/>
                                        <Setter TargetName="bg" Property="BorderBrush" Value="#D13639"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
            <TextBlock Text="🔊" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Button>

        <Controls:AudioMixerControl
            x:Name="AudioMixerPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="10"/>

    </Grid>
</Window>