<Window x:Class="Brumak_Client.Forms.CharacterCreation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:Brumak_Client.Forms.Controls"
        Title="Brumak - Crear personaje"
        Height="600" Width="1000"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#111"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Forms/Style/MainStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ClassItemSelected" TargetType="Border">
                <Setter Property="Background" Value="#33FFAA44"/>
                <Setter Property="BorderBrush" Value="#FFAA44"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="ClassItem" TargetType="Border">
                <Setter Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="ColorSwatch" TargetType="Border">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="ColorSwatchSelected" TargetType="Border">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="BorderBrush" Value="#FFAA44"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="NameInput" TargetType="TextBox">
                <Setter Property="Height" Value="38"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="White"/>
                <Setter Property="SelectionBrush" Value="#44FFAA44"/>
            </Style>

            <Style x:Key="CreateButton" TargetType="Button">
                <Setter Property="Background" Value="#FFAA44"/>
                <Setter Property="Foreground" Value="#111"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#FFBB66"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#FF9922"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                    <Setter Property="Foreground" Value="#44FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryBtn" TargetType="Button">
                <Setter Property="Background" Value="#22FFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="3" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#44FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>

        <Rectangle Fill="#0D0D14"/>
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.3" RadiusX="0.6" RadiusY="0.5">
                    <GradientStop Color="#1A1A3A" Offset="0"/>
                    <GradientStop Color="#0D0D14" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Border Width="280"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="#AA000000"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                   Text="CLASE"
                   FontSize="10"
                   FontWeight="Bold"
                   Foreground="#88FFFFFF"
                   FontFamily="Segoe UI"
                   Margin="16,70,16,10"/>

                <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      Margin="0,0,0,0">
                    <WrapPanel x:Name="ClassGrid"
                       Margin="16,0,16,8"
                       ItemWidth="116"/>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="16,0,16,16">
                    <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,0,0,12"/>
                    <TextBlock x:Name="SelectedClassName"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="White"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>
                    <TextBlock x:Name="SelectedClassDesc"
                       FontSize="11"
                       Foreground="#99FFFFFF"
                       FontFamily="Segoe UI"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="280,0,280,0">

            <Ellipse Width="200" Height="60"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,80"
                     HorizontalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2244FFAA" Offset="0"/>
                        <GradientStop Color="#0044FFAA" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Border x:Name="CharacterPreviewHost"
                    Width="180" Height="240"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,20,0,60"
                    Background="Transparent"/>

            <Button x:Name="RotateLeftBtn"
                    Visibility="Hidden"
                    Content="‹"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="20,60,0,0"
                    Width="36" Height="36"
                    FontSize="20"
                    Style="{StaticResource SecondaryBtn}"
                    Click="RotateLeft_Click"/>

            <Button x:Name="RotateRightBtn"
                    Visibility="Hidden"
                    Content="›"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,60,20,0"
                    Width="36" Height="36"
                    FontSize="20"
                    Style="{StaticResource SecondaryBtn}"
                    Click="RotateRight_Click"/>

            <StackPanel VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Width="280"
                        Margin="0,0,0,30">

                <StackPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="NOMBRE DE PERSONAJE"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#88FFFFFF"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="RandomNameBtn"
                                Content="⟳"
                                Width="24" Height="24"
                                FontSize="12"
                                Margin="8,0,0,0"
                                Style="{StaticResource WindowButton}"
                                Click="RandomName_Click"/>
                    </StackPanel>
                    <TextBox x:Name="CharacterNameInput"
                             Style="{StaticResource NameInput}"
                             MaxLength="16"/>
                </StackPanel>

                <Button x:Name="CreateBtn"
                        Content="CREAR PERSONAJE"
                        Style="{StaticResource CreateButton}"
                        IsEnabled="False"
                        Click="Create_Click"/>
            </StackPanel>
        </Grid>

        <Border Width="240"
        HorizontalAlignment="Right"
        VerticalAlignment="Stretch"
        Background="#AA000000"
        BorderBrush="#22FFFFFF"
        BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,70,0,0">
                <StackPanel Margin="14,0,14,20">

                    <TextBlock Text="COLORES"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="#88FFFFFF"
                       FontFamily="Segoe UI"
                       Margin="0,0,0,12"/>

                    <Border x:Name="ActiveSlotIndicator"
                    Background="#1AFFAA44"
                    BorderBrush="#33FFAA44"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8,6"
                    Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="ActiveSlotPreview"
                            Width="16" Height="16"
                            CornerRadius="2"
                            Background="White"
                            BorderBrush="#44FFFFFF"
                            BorderThickness="1"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"/>
                            <TextBlock Text="Editando: "
                               FontSize="10"
                               Foreground="#88FFFFFF"
                               VerticalAlignment="Center"/>
                            <TextBlock x:Name="ActiveSlotName"
                               Text="PIEL"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#FFAA44"
                               VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Border Width="8" Height="8" CornerRadius="4"
                            Background="#C8B48C" Margin="0,0,6,0"
                            VerticalAlignment="Center"/>
                            <TextBlock Text="PIEL" FontSize="9" Foreground="#88FFFFFF"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <WrapPanel x:Name="SkinColorPanel" Orientation="Horizontal"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Border Width="8" Height="8" CornerRadius="4"
                            Background="#783C28" Margin="0,0,6,0"
                            VerticalAlignment="Center"/>
                            <TextBlock Text="ROPA PRINCIPAL" FontSize="9" Foreground="#88FFFFFF"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <WrapPanel x:Name="ClothColorPanel" Orientation="Horizontal"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Border Width="8" Height="8" CornerRadius="4"
                            Background="#50321E" Margin="0,0,6,0"
                            VerticalAlignment="Center"/>
                            <TextBlock Text="ACENTO" FontSize="9" Foreground="#88FFFFFF"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <WrapPanel x:Name="AccentColorPanel" Orientation="Horizontal"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Border Width="8" Height="8" CornerRadius="4"
                            Background="#4488CC" Margin="0,0,6,0"
                            VerticalAlignment="Center"/>
                            <TextBlock Text="COLOR 1" FontSize="9" Foreground="#88FFFFFF"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <WrapPanel x:Name="Custom1ColorPanel" Orientation="Horizontal"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Border Width="8" Height="8" CornerRadius="4"
                            Background="#CC4444" Margin="0,0,6,0"
                            VerticalAlignment="Center"/>
                            <TextBlock Text="COLOR 2" FontSize="9" Foreground="#88FFFFFF"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <WrapPanel x:Name="Custom2ColorPanel" Orientation="Horizontal"/>
                    </StackPanel>

                    <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,4,0,12"/>

                    <TextBlock Text="COLOR PERSONALIZADO"
                       FontSize="9"
                       FontWeight="Bold"
                       Foreground="#88FFFFFF"
                       FontFamily="Segoe UI"
                       Margin="0,0,0,8"/>

                    <Border x:Name="HexPreview"
                    Height="36"
                    CornerRadius="4"
                    Margin="0,0,0,8"
                    Background="White"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1">
                        <TextBlock x:Name="HexPreviewLabel"
                           Text="#FFFFFF"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="Black"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"/>
                    </Border>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="HexInput"
                         Grid.Column="0"
                         Height="34"
                         FontSize="12"
                         FontFamily="Consolas"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         Background="#1AFFFFFF"
                         Foreground="White"
                         BorderBrush="#33FFFFFF"
                         BorderThickness="1"
                         CaretBrush="White"
                         MaxLength="7"
                         Text="#FFFFFF"
                         TextChanged="HexInput_TextChanged"/>

                        <Button Grid.Column="2"
                        x:Name="ApplyHexBtn"
                        Content="APLICAR"
                        Width="62"
                        Height="34"
                        FontSize="9"
                        FontWeight="Bold"
                        Style="{StaticResource SecondaryBtn}"
                        Click="ApplyHex_Click"/>
                    </Grid>

                    <TextBlock Text="RECIENTES"
                       FontSize="9"
                       Foreground="#55FFFFFF"
                       FontFamily="Segoe UI"
                       Margin="0,0,0,6"/>
                    <WrapPanel x:Name="CustomColorPanel" Orientation="Horizontal"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid VerticalAlignment="Top" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="‹"
                    Style="{StaticResource WindowButton}"
                    Click="Back_Click"/>

            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="NicknameLabel"
                           Text="{Binding Nickname}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="White"
                           FontFamily="Segoe UI"/>
                <TextBlock x:Name="PremiumLabel"
                           Text="{Binding PremiumStatus}"
                           FontSize="10"
                           Foreground="#FFAA44"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Rectangle Width="40" Height="1" Fill="#88FFAA44" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Crear personaje"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <Rectangle Width="40" Height="1" Fill="#88FFAA44" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click"/>
                <Button Content="X" Style="{StaticResource WindowButton}" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Button HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,14,14"
                Width="36" Height="36"
                FontSize="14"
                Panel.ZIndex="2"
                Cursor="Hand"
                Click="AudioBtn_Click"
                ToolTip="Ajustes de audio">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#161616"/>
                    <Setter Property="BorderBrush" Value="#2C2C2C"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Foreground" Value="#888888"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#D13639"/>
                                        <Setter TargetName="bg" Property="BorderBrush" Value="#D13639"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
            <TextBlock Text="🔊" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Button>

        <Controls:AudioMixerControl
            x:Name="AudioMixerPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="10"/>

    </Grid>
</Window>